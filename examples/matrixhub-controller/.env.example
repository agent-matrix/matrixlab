# MatrixHub controller settings
MATRIXHUB_API_TOKEN=dev-matrixhub-token
MATRIXHUB_CATALOG_PATH=./catalog.example.json

# Hugging Face Space worker settings
HF_SPACE_URL=https://YOUR-ORG-YOUR-SPACE.hf.space
MATRIXLAB_SANDBOX_TOKEN=replace-with-the-same-token-configured-in-hf-space

# Optional Hugging Face Hub controls. Needed only if you want the controller to wake/pause Spaces.
HF_TOKEN=
HF_SPACE_ID=YOUR-ORG/YOUR-SPACE
HF_AUTO_PAUSE=false
